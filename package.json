{
  "name": "veilroom",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm run build:client && cd server-go && go run .",
    "build:client": "vite build",
    "build": "pnpm run build:client && cd server-go && go build -o ../dist/veilroom .",
    "start": "./dist/veilroom",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "5.9.3",
    "vite": "^7.1.9",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@10.4.1"
}
